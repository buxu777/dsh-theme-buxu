{
  "name": "dsh-theme-buxu",
  "version": "0.10.0",
  "description": "不虚 · 质肤 / Buxu Skin — a full DSH personalization suite: multi-palette schemes, conversation avatars, and a settings page for accent / radius / sidebar / bubble tuning.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "skin",
    "buxu",
    "personalization",
    "avatar"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buxu777/dsh-theme-buxu.git"
  },
  "homepage": "https://github.com/buxu777/dsh-theme-buxu#readme",
  "bugs": {
    "url": "https://github.com/buxu777/dsh-theme-buxu/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "author": "buxu777",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
